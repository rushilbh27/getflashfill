{
  "manifest_version": 3,
  "name": "FlashFill",
  "version": "0.1.0",
  "description": "Zero-click burner identity and OTP automation for signup forms.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.rapidapi.com/*"
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/observer.ts-loader-e4baae2e.js",
        "assets/detector.ts-loader-b46455b7.js",
        "assets/injector.ts-loader-1e9bdd43.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "FlashFill",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/detector.ts-3fdf9f04.js",
        "assets/observer.ts-0010eb7d.js",
        "assets/injector.ts-592df3f9.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
